{
  "name": "surrey-arcgis-proof",
  "version": "1.0.0",
  "private": true,
  "description": "Public-data ArcGIS Maps SDK for JavaScript technical proof by ParalleX Labs Inc. Not a City of Surrey system.",
  "license": "Apache-2.0",
  "author": "ParalleX Labs Inc.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke:live": "node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@arcgis/core": "4.32.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.29.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.32",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.29.0",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.1",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
